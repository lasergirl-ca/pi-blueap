[Unit]
Description=palm-gw: ensure the Palm bridge exists via NetworkManager
After=NetworkManager.service
Wants=NetworkManager.service
Before=palm-gwd.service palm-gw-dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Written by `palm-gw setup --apply` from config.toml, so this unit stays the same for every
# configuration and can ship in the package.
EnvironmentFile=/etc/palm-gw/bridge.env
ExecStart={{LIB_DIR}}/nm-bridge.sh ${BRIDGE} ${GATEWAY} ${PREFIX}

[Install]
WantedBy=multi-user.target
